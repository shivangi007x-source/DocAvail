// DocAvail Database Schema
// Supported on SQLite for local development, easily scalable to PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  role            String    @default("PATIENT") // PATIENT, DOCTOR, ADMIN
  name            String
  avatarUrl       String?
  approvalStatus  String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt      DateTime?
  rejectedAt      DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  patientAppointments Appointment[]     @relation("PatientAppointments")
  reportsSubmitted    ReportedAccount[] @relation("SubmittedReports")
  reportsReceived     ReportedAccount[] @relation("ReceivedReports")
  reviewsGiven        Review[]          @relation("PatientReviews")

  @@index([approvalStatus])
}

model PatientProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  location    String?
  dateOfBirth DateTime?
  gender      String?
  bloodGroup  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  doctorAccessGrants DoctorPatientAccess[]
}

model DoctorProfile {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization     String
  qualification      String
  experience         Int    @default(0)
  licenseNumber      String
  verificationStatus      String  @default("PENDING") // PENDING, APPROVED, REJECTED
  phone                   String?
  verificationDocName     String?
  verificationDocMime     String?
  verificationDocSize     Int?
  verificationDocContent  Bytes?
  consultationFee    Float  @default(0.0)
  clinicName         String
  clinicAddress      String
  city               String
  consultationType   String @default("IN_PERSON") // IN_PERSON, VIDEO, BOTH

  // Conditions treated / areas of clinical expertise
  treatedConditions String? // comma-separated list of conditions

  // Geographic coordinates & district location (Nullable extensions)
  district  String?
  division  String? // Jammu, Kashmir
  latitude  Float?
  longitude Float?

  // Real-time availability status (Phase 1 & Phase 3)
  availabilityStatus String    @default("AVAILABLE") // AVAILABLE, BUSY, UNAVAILABLE
  statusNote         String? // Optional context (e.g., "In surgery until 3 PM")
  statusUpdatedAt    DateTime?

  // Rating aggregate
  rating      Float @default(5.0)
  reviewCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  workingHours         WorkingHours[]
  slots                AppointmentSlot[]
  appointments         Appointment[]               @relation("DoctorAppointments")
  reviews              Review[]                    @relation("DoctorReviews")
  authoredRecords      MedicalRecord[]             @relation("AuthoredRecords")
  prescriptions        Prescription[]              @relation("DoctorPrescriptions")
  patientAccessGrants  DoctorPatientAccess[]       @relation("DoctorAccessGrants")
  facilityAffiliations DoctorFacilityAffiliation[]

  @@index([specialization])
  @@index([city])
  @@index([district])
  @@index([division])
  @@index([verificationStatus])
  @@index([availabilityStatus])
}

model MedicalRecord {
  id            String         @id @default(uuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        DoctorProfile? @relation("AuthoredRecords", fields: [doctorId], references: [id], onDelete: SetNull)
  title         String
  recordType    String // DIAGNOSIS, ALLERGY, MEDICATION, CONSULTATION_NOTE, LAB_REPORT, OTHER
  description   String
  diagnosedDate DateTime?
  severity      String? // MILD, MODERATE, SEVERE
  status        String?        @default("ACTIVE") // ACTIVE, RESOLVED, CHRONIC
  fileUrl       String?
  addedByRole   String         @default("PATIENT") // PATIENT, DOCTOR
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([recordType])
}

model Prescription {
  id             String         @id @default(uuid())
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile  @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String // e.g. "500mg"
  frequency      String // e.g. "Twice daily after meals"
  duration       String // e.g. "7 days", "Ongoing"
  instructions   String?
  prescribedDate DateTime       @default(now())
  status         String         @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model DoctorPatientAccess {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile  @relation("DoctorAccessGrants", fields: [doctorId], references: [id], onDelete: Cascade)
  status    String         @default("GRANTED") // GRANTED, REVOKED
  grantedAt DateTime       @default(now())
  revokedAt DateTime?
  reason    String? // e.g. "Direct consultation grant", "Patient consent"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model WorkingHours {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime           String // e.g. "09:00"
  endTime             String // e.g. "17:00"
  breakStart          String? // e.g. "13:00"
  breakEnd            String? // e.g. "14:00"
  slotDurationMinutes Int           @default(30)
  isActive            Boolean       @default(true)

  @@unique([doctorId, dayOfWeek])
}

model AppointmentSlot {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean       @default(false)
}

model Appointment {
  id               String        @id @default(uuid())
  patientId        String
  patient          User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  date             DateTime      @default(now())
  startTime        String
  endTime          String
  status           String        @default("PENDING") // PENDING, CONFIRMED, REJECTED, COMPLETED, CANCELLED
  consultationType   String        @default("IN_PERSON") // IN_PERSON, VIDEO
  reasonForVisit     String?
  symptoms           String?
  existingConditions String?
  currentMedications String?
  knownAllergies     String?
  patientNotes       String?
  doctorNotes      String?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model ReportedAccount {
  id             String   @id @default(uuid())
  reporterId     String
  reporter       User     @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String
  reportedUser   User     @relation("ReceivedReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reason         String
  status         String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())
}

model Review {
  id        String        @id @default(uuid())
  patientId String
  patient   User          @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile @relation("DoctorReviews", fields: [doctorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime      @default(now())
}

model HealthcareFacility {
  id                  String   @id @default(uuid())
  name                String
  facilityType        String   // HOSPITAL, CHC, PHC, SUB_CENTRE, CLINIC, DIAGNOSTIC_CENTRE
  category            String?  // Public / Government, Private, Charitable
  district            String   // Anantnag, Bandipora, Baramulla, Budgam, Doda, Ganderbal, Jammu, Kathua, Kishtwar, Kulgam, Kupwara, Poonch, Pulwama, Rajouri, Ramban, Reasi, Samba, Shopian, Srinagar, Udhampur
  division            String   // Jammu, Kashmir
  tehsil              String?
  address             String
  city                String?
  pincode             String?
  latitude            Float?
  longitude           Float?
  contactNumber       String?
  email               String?
  emergencyServices   Boolean? // true (confirmed), false (confirmed absent), null (unverified)
  operationalStatus   String   @default("UNKNOWN") // ACTIVE, CLOSED, UNKNOWN
  operationalVerified Boolean  @default(false)
  locationVerified    Boolean  @default(false)
  sourceVerified      Boolean  @default(false)
  sourceReference     String   // Mandatory provenance reference (e.g. NHM Directory 2024, PM-JAY Empanelled list, OSM Node)
  sourceAttribution   String   // Mandatory attribution (e.g. "National Health Mission, J&K", "OpenStreetMap contributors")
  metadata            Json?    // Optional structured JSON metadata for extra verified fields (bed count, specialties)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationships
  doctorAffiliations DoctorFacilityAffiliation[]

  @@index([district])
  @@index([division])
  @@index([facilityType])
  @@index([operationalStatus])
}

model DoctorFacilityAffiliation {
  id               String             @id @default(uuid())
  doctorId         String
  doctor           DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facilityId       String
  facility         HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  role             String?            // e.g. "Consultant Cardiologist", "Visiting Surgeon"
  isPrimary        Boolean            @default(false)
  consultationFee  Float?             // Facility-specific fee override
  visitingSchedule String?            // e.g. "Mon, Wed, Fri 10:00-14:00"
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([doctorId, facilityId])
  @@index([doctorId])
  @@index([facilityId])
}

